# Public site URL (optional; defaults to localhost in dev)
# NUXT_PUBLIC_SITE_URL=https://example.com

# Admin studio (required for /studio). Use a long random session secret.
NUXT_ADMIN_PASSWORD=change-me
NUXT_ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Coming-soon gate (production / preview builds). When set, visitors need this code.
# Local `pnpm dev` ignores this and stays ungated.
# NUXT_PREVIEW_CODE=friends-only-code


# Deploy target:
# - Local / pnpm dev: catalog writes to data/shop-catalog.json
# - Cloudflare Pages: bind D1 (DB) + R2 (MEDIA), set the same NUXT_* secrets in the dashboard
# - GitHub Pages: static only; studio writes do not persist on the live site
